<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- NETOmniDriver-NET40 is a mixed-mode assembly; keep the default legacy
         binding behaviour off but allow the loader to bind across the 2.x
         OmniDriver revisions without an exact version match. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="NETOmniDriver-NET40" publicKeyToken="5ceb6b3940bb24a4" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-65535.65535.65535.65535" newVersion="2.45.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
